{
  "manifest_version": 3,
  "name": "Kasiski — Sala de Disputa",
  "version": "0.1.0",
  "description": "Lê a sala de disputa do Compras.gov.br aberta por você e mostra lances, posição e mensagens na sala do Kasiski. Não envia lances.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "https://certame-api-va8f.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Kasiski — Sala de Disputa" },
  "content_scripts": [
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-web/*"],
      "js": ["comum.js", "adaptadores/comprasgov.js", "observador.js"],
      "run_at": "document_idle"
    }
  ]
}
